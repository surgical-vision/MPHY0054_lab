Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 10
      Alpha: 0.4
      Color: 160; 160; 164
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: YouBot
      Enabled: true
      Alpha: 0.65
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Links:
        All Links Enabled: true
      Value: true
    - Class: rviz_default_plugins/TF
      Name: Q5d DH frames
      Enabled: true
      Frame Timeout: 5
      Frames:
        All Enabled: false
        arm5d_link_1:
          Value: true
        arm5d_link_2:
          Value: true
        arm5d_link_3:
          Value: true
        arm5d_link_4:
          Value: true
        arm5d_link_5:
          Value: true
      Marker Scale: 0.3
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/TF
      Name: URDF flange comparison
      Enabled: false
      Frame Timeout: 5
      Frames:
        All Enabled: false
        arm_link_5:
          Value: true
      Marker Scale: 0.4
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.1
      Focal Point:
        X: 0
        Y: 0
        Z: 0.25
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.45
      Target Frame: base_link
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Width: 1280
  Height: 800
  Hide Left Dock: false
  Hide Right Dock: false
